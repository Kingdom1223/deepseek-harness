# 使用相对缓存目录，项目复制到其他盘符或其他电脑后仍可直接安装。
cache=.npm-cache

# DSH 的插件包之间 peer 依赖用的是 ^0.1.5-rc.N 这种预发布区间，
# npm 的严格 peer 解析会在 rc 版本之间互相打架（rc.1 与 rc.2 互不满足）。
# DSH 自己的 profile 用的是 pnpm 的 autoInstallPeers: false，语义上等价于这里
# 不安装 peer、只用顶层已装的同一份。所以关掉 peer 自动安装。
legacy-peer-deps=true

fund=false
audit=false
loglevel=notice
