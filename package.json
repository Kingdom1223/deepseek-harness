  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "^26.0.12",
    "sharp": "0.35.4"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@img/**",
      "node_modules/@koromix/**",
      "node_modules/@vscode/ripgrep-win32-x64/**",
      "node_modules/node-addon-require-builtin-win32-x64-msvc/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DeepSeek-Harness-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.5-rc.2": true,
    "@google/genai@1.52.0": true,
    "koffi@3.3.0": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.4": true
  }
}
