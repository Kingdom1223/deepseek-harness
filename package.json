  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness Desktop — runs the DSH runtime in-process, with its own window chrome and themeable UI",
  "author": "DeepSeek Harness Desktop",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "deps:check": "node scripts/sync-deps.mjs --check",
    "deps:sync": "node scripts/sync-deps.mjs",
    "profile:check": "node scripts/verify-profile.mjs",
    "test:electron": "node scripts/run-electron-smoke.mjs",
    "test:packaged": "node scripts/run-packaged-smoke.mjs",
    "test:installed": "node scripts/run-packaged-smoke.mjs --installed",
    "test:installer": "node scripts/run-installer-smoke.mjs",
    "update:configure": "node scripts/configure-github-updates.mjs",
    "update:artifacts:check": "node scripts/verify-update-artifacts.mjs",
    "build:win": "electron-builder --win --x64",
    "build:release:github": "node scripts/build-github-release.mjs",
    "pack:dir": "electron-builder --win --x64 --dir",
    "release:check": "npm run deps:check && npm test && npm run profile:check && npm run test:electron",
    "release:win": "npm run release:check && npm run build:win && npm run test:installer"
  },
